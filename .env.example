# VERIFRAME Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Database Configuration (Optional - standard fallback in-memory database will run automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veriframe_db

# Security & Secrets
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
API_KEY_SECRET=change-me-generate-with-openssl-rand-hex-32

# AI Model Service Integration (Optional - standard MockMediaAnalyzer runs by default)
AI_ENGINE_SERVICE_URL=http://localhost:8000/v1/inference

# Comma-separated allowlist for CORS (defaults to http://localhost:3000 when unset)
CORS_ORIGINS=http://localhost:3000

# Detection engine: forensic (real, no-ML) | mock (demo) | pytorch (calls AI_ENGINE_SERVICE_URL)
ANALYZER=forensic

# Auth token lifetime
JWT_EXPIRES_IN=12h
